# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://localhost:5173

# PostgreSQL Database Connection (Local / Backend)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=project_hall

# Docker Compose Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=project_hall
HOST_PGPORT=5433

# JWT & OIDC Configuration
JWT_ISSUER=https://localhost:5000
JWT_AUDIENCE=https://localhost:5173
SESSION_SECRET=change_this_to_a_secure_random_string_in_production

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://localhost:5000/api/auth/google/callback

# Logging & Storage
LOG_LEVEL=info
